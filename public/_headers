# Cloudflare Pages/Workers headers.
#
# O shell da SPA não pode ser cacheado: os ficheiros JS têm hash no nome, mas o
# index.html é quem diz quais são. Quando a edge serve um index.html antigo, o
# browser carrega o bundle anterior mesmo com o novo já publicado — foi o que
# fez o staging continuar a chamar a API de produção depois do deploy.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/404.html
  Cache-Control: no-cache

# Os restantes ficheiros têm hash no nome, portanto podem ser guardados para
# sempre: um conteúdo novo traz sempre um nome novo.
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable
